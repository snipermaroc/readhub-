# Admin Credentials (Required in production)
ADMIN_PASSWORD=YourStrongAdminPasswordHere!

# Google Cloud / Google Drive API (Optional - for Drive to CSV converter)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# Image Proxy Allowed CDNs (Optional - comma-separated list of additional trusted image CDNs)
PROXY_ALLOWED_HOSTS=cdn.mytrusteddomain.com,images.partner.com

# PostgreSQL Connection (CapRover / Self-Hosted)
# Option 1: Full connection URI
DATABASE_URL=postgresql://postgres:your_password@your-caprover-host:5432/readhub?sslmode=disable

# Option 2: Individual variables
PGHOST=your-caprover-host
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password
PGDATABASE=readhub
PGSSL=false
