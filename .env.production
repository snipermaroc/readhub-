# ═══════════════════════════════════════════════════════════════════════════════
# READHUB — Production Environment Variables
# Copy this file to .env on your server or paste values into CapRover's
# App Config → Environment Variables section.
# Lines starting with # are comments — remove # before the key when filling in.
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — App will refuse to start in production without these
# ─────────────────────────────────────────────────────────────────────────────

# Node environment — must be "production" for security headers, cookie Secure flag, etc.
NODE_ENV=production

# Admin account password (min 12 chars, mix upper/lower/digits/symbols)
# The first boot creates admin@readhub.com with this password.
# CHANGE THIS — the app exits at startup if this is missing in production.
ADMIN_PASSWORD=ReplaceWithYourStrongPassword123!

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — PostgreSQL Database
# Use ONE of the two options below (URI or individual variables).
# ─────────────────────────────────────────────────────────────────────────────

# Option A — full connection URI (recommended for most providers)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=disable
# Examples:
#   CapRover internal PostgreSQL one-click app:
DATABASE_URL=postgresql://readhub_user:readhub_pass@srv-captain--readhub-db:5432/readhub?sslmode=disable
#   Supabase (Transaction pooler):
# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-eu-west-3.pooler.supabase.com:5432/postgres
#   Render / Railway / Neon / Aiven — paste the connection string they give you

# Option B — individual variables (use INSTEAD of DATABASE_URL, not both)
# PGHOST=srv-captain--readhub-db
# PGPORT=5432
# PGUSER=readhub_user
# PGPASSWORD=readhub_pass
# PGDATABASE=readhub
# PGSSL=false

# ─────────────────────────────────────────────────────────────────────────────
# RECOMMENDED — CORS / Allowed Origins
# ─────────────────────────────────────────────────────────────────────────────

# The public URL of your deployed app (no trailing slash).
# Used for CORS origin allowlist and cookie Same-Site policy.
APP_URL=https://readhub.yourdomain.com

# Additional origins allowed to call the API (comma-separated, no spaces).
# Add your custom manga subdomain URLs here if you use them.
# ALLOWED_ORIGINS=https://solo-leveling.yourdomain.com,https://jjk.yourdomain.com

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Google Drive Connector
# ─────────────────────────────────────────────────────────────────────────────

# Path inside the container to the GCP service account JSON key.
# Mount the file as a Docker secret or CapRover config file, then point here.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-credentials.json

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Image Proxy Trusted CDN Hosts
# ─────────────────────────────────────────────────────────────────────────────

# Comma-separated list of extra CDN hostnames the image proxy is allowed to fetch from.
# The built-in allowlist already includes: images.unsplash.com, i.imgur.com,
# lh3.googleusercontent.com, uploads.mangadex.org, s4.anilist.co, media.kitsu.io
# PROXY_ALLOWED_HOSTS=cdn.mymangasite.com,images.partner.net

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Server Bind
# ─────────────────────────────────────────────────────────────────────────────

# Port the Express server listens on inside the container.
# CapRover maps this to its reverse proxy automatically — keep at 3000.
PORT=3000

# Bind host inside container — 0.0.0.0 is correct for Docker/CapRover.
HOST=0.0.0.0
